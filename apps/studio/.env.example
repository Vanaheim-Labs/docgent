# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=***

# openssl rand -base64 32
AUTH_SECRET=***

# Repo Studio reads
DOCFORGE_REPO=Vanaheim-Labs/docforge
DOCFORGE_BRANCH=main

# Token with 'repo' scope, used for repo reads/writes.
# Studio uses this rather than the signed-in user's token so access is
# governed by org membership, not by whoever happens to hold a PAT.
DOCFORGE_GH_TOKEN=

# Access control: only members of this GitHub org may sign in.
DOCFORGE_ALLOWED_ORG=Vanaheim-Labs

# Render worker (Phase 2)
DOCFORGE_RENDER_URL=https://docforge-render.fly.dev
DOCFORGE_API_KEY=
