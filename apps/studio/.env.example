# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorised redirect URI must be:
#   https://<studio-domain>/api/auth/callback/google
# and for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# openssl rand -base64 32
AUTH_SECRET=

# Repo Studio reads
DOCFORGE_REPO=Vanaheim-Labs/docforge
DOCFORGE_BRANCH=main

# Token with 'repo' scope, used for repo reads/writes.
# Studio uses this rather than the signed-in user's token so access is
# governed by org membership, not by whoever happens to hold a PAT.
DOCFORGE_GH_TOKEN=

# --- Access control ---------------------------------------------------------
# GitHub path: only members of this GitHub org may sign in.
DOCFORGE_ALLOWED_ORG=Vanaheim-Labs

# Google path: exact addresses allowed in, comma separated.
# Guests authenticated this way get Studio access only; they never receive
# any GitHub repository permission.
DOCFORGE_ALLOWED_EMAILS=

# Optional and deliberately empty by default. Any address at these domains may
# sign in. Prefer DOCFORGE_ALLOWED_EMAILS unless you genuinely mean everyone.
DOCFORGE_ALLOWED_DOMAINS=

# Render worker (Phase 2)
DOCFORGE_RENDER_URL=https://docforge-render.fly.dev
DOCFORGE_API_KEY=
