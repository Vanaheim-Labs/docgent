# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorised redirect URI must be:
#   https://<studio-domain>/api/auth/callback/google
# and for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# openssl rand -base64 32
AUTH_SECRET=

# Repo Studio reads
DOCFORGE_REPO=Vanaheim-Labs/docforge
DOCFORGE_BRANCH=main

# Token with 'repo' scope, used for repo reads/writes against every brand's
# document store. Studio uses this rather than the signed-in user's token so
# repo access is governed centrally, not by whoever happens to hold a PAT.
DOCFORGE_GH_TOKEN=

# --- Access control ----------------------------------------------------------
# Who may sign in is governed per-brand by the `access:` block in each
# brands/<id>/brand.yaml (emails: [...] and/or domains: [...]), checked
# server-side in src/auth.ts. There is no environment-variable allowlist —
# each domain's rule lives with that brand's own config.

# --- Domain routing -----------------------------------------------------------
# Maps each production hostname to the one brand it serves. Comma-separated
# host=brand pairs. A host with no entry here has no per-brand restriction
# (dev convenience) and, for sign-in specifically, is rejected outright by
# auth.ts (fail closed rather than falling back to any brand).
#
# Example:
# DOCFORGE_HOST_BRANDS=docs.vanaheim.com.au=vanaheim,docs.northface.vc=northface,docs.inkl.com=inkl
DOCFORGE_HOST_BRANDS=

# Render worker (Phase 2)
DOCFORGE_RENDER_URL=https://docforge-render.fly.dev
DOCFORGE_API_KEY=
